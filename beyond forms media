              {services.map((s, i) => (
                <div key={i} className="rounded-2xl border border-white/[0.08] bg-[#111113] p-8 hover:border-emerald/40 transition-all">
                  <span className="font-mono text-emerald font-bold text-sm">{s.num}</span>
                  <h3 className="mt-3 text-xl font-bold text-[#F4F4F0]">{s.title}</h3>
                  <p className="mt-2 text-sm text-[#A1A1A8] leading-relaxed">{s.desc}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      );
    }

    /* ═══════════════════════════════════════════════
       FOOTER
       ═══════════════════════════════════════════════ */
    function Footer() {
      const copyEmail = () => {
        navigator.clipboard.writeText("hello@beyondformsmedia.com");
        alert("Email copied to clipboard: hello@beyondformsmedia.com");
      };

      return (
        <footer className="py-20 px-6 md:px-12 bg-[#09090A] border-t border-white/[0.08]">
          <div className="max-w-7xl mx-auto flex flex-col items-center text-center">
            <span className="font-mono text-xs uppercase tracking-widest text-emerald font-semibold">BEYOND FORMS MEDIA</span>
            <h2 className="mt-4 text-4xl sm:text-6xl font-extrabold tracking-tight text-[#F4F4F0]">Ready to build something iconic?</h2>
            
            <button onClick={copyEmail} className="mt-6 px-6 py-3 rounded-full border border-white/15 bg-white/5 font-mono text-sm text-[#F4F4F0] hover:bg-white/10 transition-colors">
              hello@beyondformsmedia.com (Click to Copy)
            </button>

            <div className="mt-16 text-xs font-mono text-[#8E8E93]">
              &copy; {new Date().getFullYear()} Beyond Forms Media. All rights reserved.
            </div>
          </div>
        </footer>
      );
    }

    /* ═══════════════════════════════════════════════
       BOOKING MODAL
       ═══════════════════════════════════════════════ */
    function BookingModal({ isOpen, onClose }) {
      if (!isOpen) return null;
      return (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-carbon/90 backdrop-blur-xl">
          <div className="relative w-full max-w-lg rounded-2xl bg-[#111113] border border-white/15 p-8 text-center shadow-2xl">
            <button onClick={onClose} className="absolute top-4 right-4 text-white/60 hover:text-white">✕</button>
            <span className="px-3 py-1 rounded-full bg-emerald/10 text-emerald font-mono text-xs font-semibold">STRATEGY SESSION</span>
            <h3 className="mt-4 text-2xl font-bold text-[#F4F4F0]">Book a 30-Minute Architecture Call</h3>
            <p className="mt-2 text-sm text-[#A1A1A8]">We will review your current retention curves, audit your pacing, and blueprint your content engine.</p>
            <div className="mt-6 space-y-3">
              <input type="text" placeholder="Your Name" className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-sm text-white focus:outline-none focus:border-emerald" />
              <input type="email" placeholder="Your Work Email" className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-sm text-white focus:outline-none focus:border-emerald" />
              <input type="text" placeholder="Channel / Brand Link" className="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 text-sm text-white focus:outline-none focus:border-emerald" />
              <button onClick={() => { alert("Thanks! We will be in touch within 24 hours."); onClose(); }} className="w-full py-3.5 rounded-xl bg-emerald text-carbon font-bold text-sm hover:bg-[#F4F4F0] transition-colors shadow-lg">
                Submit Strategy Request ▷
              </button>
            </div>
          </div>
        </div>
      );
    }

    /* ═══════════════════════════════════════════════
       ROOT APP
       ═══════════════════════════════════════════════ */
    function App() {
      const [selectedProject, setSelectedProject] = useState(null);
      const [isBookingOpen, setIsBookingOpen] = useState(false);

      return (
        <div className="min-h-screen bg-[#09090A] text-[#F4F4F0]">
          <Header onBookCall={() => setIsBookingOpen(true)} />
          <Hero />
          <AboutSection onBookCall={() => setIsBookingOpen(true)} />
          <Marquee />
          <SelectedWork onProjectClick={(p) => setSelectedProject(p)} />
          <Services />
          <Footer />

          <ProjectModal project={selectedProject} isOpen={!!selectedProject} onClose={() => setSelectedProject(null)} />
          <BookingModal isOpen={isBookingOpen} onClose={() => setIsBookingOpen(false)} />
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
